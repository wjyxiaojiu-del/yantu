# ===== AI Service (Paper Review) =====
# Required for paper analysis endpoint (/api/papers/:id/analyze)
AI_API_KEY=
AI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5-pro

# ===== Optional AI Assistant (DeepSeek) =====
DEEPSEEK_API_KEY=

# ===== Server =====
PORT=3002
# development | production
# production hides SMS codes from API responses
NODE_ENV=development

# ===== Error Tracking (Sentry, optional) =====
# Leave empty to disable. Both keys are independent — backend uses SENTRY_DSN, frontend uses VITE_SENTRY_DSN.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Sample rate for traces (0 = disabled, 1 = 100%)
SENTRY_TRACES_SAMPLE_RATE=0
